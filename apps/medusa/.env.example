# ─── Medusa backend · UGARIT ─────────────────────────────────────

NODE_ENV=development
PORT=9000

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ugarit

# CORS
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:7001,http://localhost:9000
AUTH_CORS=http://localhost:7001,http://localhost:9000,http://localhost:3000

# Secrets
JWT_SECRET=ugarit-jwt-secret-change-in-prod
COOKIE_SECRET=ugarit-cookie-secret-change-in-prod

# Redis (opcional en dev, requerido en prod)
REDIS_URL=

# ─── Servicios externos Chile ───────────────────────────────────

# Transbank Webpay
TRANSBANK_ENV=integration
TRANSBANK_COMMERCE_CODE=597020000540
TRANSBANK_API_KEY=

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# Chilexpress
CHILEXPRESS_API_URL=https://testservices.wschilexpress.com
CHILEXPRESS_CARD_CODE=

# DTE (Facturapi)
FACTURAPI_KEY=
FACTURAPI_ENV=test

# Resend (email)
RESEND_API_KEY=
RESEND_FROM="UGARIT <contacto@ugarit.cl>"

# Cloudflare R2 (storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ugarit-store
R2_PUBLIC_URL=

# Meilisearch
MEILISEARCH_HOST=
MEILISEARCH_MASTER_KEY=
